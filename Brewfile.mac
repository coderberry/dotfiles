# Brewfile.mac — Curated essentials for macOS.
#
# Usage:
#   brew bundle --file=Brewfile.mac
#
# Philosophy: install only what you actually use. Every line carries a short
# description of what the tool is for. Specialty tools from previous setups
# are listed (commented) under "Optional" at the bottom — uncomment what you
# still need.

# ──────────────────────────────────────────────────────────────────────────────
# Modern shell stack (drives the .zshrc)
# ──────────────────────────────────────────────────────────────────────────────
brew "stow"            # symlink farm manager — used by install.sh to link dotfiles
brew "starship"        # cross-shell prompt; configured in .config/starship.toml
brew "atuin"           # SQLite-backed shell history with full-text search
brew "zoxide"          # smarter `cd` that learns your habits (z foo)
brew "eza"             # modern `ls` replacement; backs the ls/ll/la/lt aliases
brew "fzf"             # command-line fuzzy finder (Ctrl+T, and fzf-tab completions)
brew "fnm"             # fast Node.js version manager; auto-switches on cd

# ──────────────────────────────────────────────────────────────────────────────
# CLI essentials
# ──────────────────────────────────────────────────────────────────────────────
brew "git"             # distributed revision control system
brew "git-lfs"         # Git extension for versioning large files
brew "gh"              # GitHub CLI — issues, PRs, releases; wrapped by `op plugin`
brew "ripgrep"         # `rg` — fast recursive search, respects .gitignore
brew "fd"              # friendlier `find`; also underpins some fzf integrations
brew "bat"             # `cat` with syntax highlighting and Git integration
brew "jq"              # command-line JSON processor
brew "direnv"          # auto-loads per-directory env vars (OMZP::direnv in .zshrc)
brew "tree"            # display directory structures as a tree
brew "oven-sh/bun/bun" # fast JS runtime, bundler, and package manager
brew "wget"            # non-interactive file retriever
brew "htop"            # interactive process viewer (better `top`)
brew "mosh"            # resilient SSH that survives roaming and flaky links
brew "mise"            # polyglot runtime manager (node/python/go/…)
brew "glow"            # render Markdown nicely in the terminal

# ──────────────────────────────────────────────────────────────────────────────
# Tunnels / networking
# ──────────────────────────────────────────────────────────────────────────────
cask "ngrok"           # secure introspectable tunnels to localhost (cask, not formula)
brew "cloudflared"     # Cloudflare Tunnel client — expose local services via CF

# ──────────────────────────────────────────────────────────────────────────────
# Editor / dev workflow
# ──────────────────────────────────────────────────────────────────────────────
brew "neovim"          # the editor; $EDITOR/$VISUAL, configured via .config/nvim
brew "lnav"            # curses log viewer with query + highlighting
brew "gitui"           # fast terminal UI for git

# ──────────────────────────────────────────────────────────────────────────────
# AI / agent tooling
# ──────────────────────────────────────────────────────────────────────────────
cask "claude-code"     # Anthropic's terminal coding agent; `update-claude` alias upgrades it
cask "codex"           # OpenAI's terminal coding agent
brew "openclaw/tap/gitcrawl"  # local GitHub issue/PR archive with gh-compatible caching

# ──────────────────────────────────────────────────────────────────────────────
# Languages / runtimes you actually use
# ──────────────────────────────────────────────────────────────────────────────
brew "go"              # Go toolchain
brew "rust"            # Rust toolchain (rustc, cargo)
brew "uv"              # extremely fast Python package/project manager
brew "pnpm"            # disk-efficient Node package manager
# brew "nvm"           # superseded by fnm (above) and mise

# ──────────────────────────────────────────────────────────────────────────────
# Media
# ──────────────────────────────────────────────────────────────────────────────
brew "ffmpeg"          # convert, record, and stream audio/video
brew "yt-dlp"          # feature-rich audio/video downloader

# ──────────────────────────────────────────────────────────────────────────────
# 1Password integration
# ──────────────────────────────────────────────────────────────────────────────
cask "1password"       # password manager; also provides the SSH agent used in .zshrc
cask "1password-cli"   # `op` — used by templates/render.sh and setup-op-plugins.sh

# ──────────────────────────────────────────────────────────────────────────────
# Terminal + keyboard (Mac-only)
# ──────────────────────────────────────────────────────────────────────────────
cask "ghostty"         # GPU-accelerated, platform-native terminal emulator
cask "karabiner-elements"  # keyboard customiser (Caps Lock → ~ rule in karabiner/)

# ──────────────────────────────────────────────────────────────────────────────
# Fonts (just two — pick from Ghostty / your editor)
# ──────────────────────────────────────────────────────────────────────────────
cask "font-jetbrains-mono-nerd-font"  # primary coding font (Ghostty default)
cask "font-meslo-lg-nerd-font"        # alternate; common Powerlevel/Starship pairing

# ──────────────────────────────────────────────────────────────────────────────
# Optional — uncomment what you still need
# ──────────────────────────────────────────────────────────────────────────────

